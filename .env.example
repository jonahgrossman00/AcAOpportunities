# opportunities_dashboard.py's login password is NOT read from .env -- it
# must be set as an "app_password" Streamlit secret instead. Locally, copy
# .streamlit/secrets.toml.example to .streamlit/secrets.toml and fill it in;
# when deployed, set it in the app's Streamlit Cloud "Secrets" settings.
